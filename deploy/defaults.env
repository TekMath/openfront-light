# openfront-light: runtime defaults of the prebuilt release tarball, the same
# values as the ENV block of Dockerfile.light. Start the server from the
# extracted folder with:
#
#   node --max-old-space-size=384 --env-file=defaults.env dist/server/Server.mjs
#
# Node never overrides a variable that is already set in the environment, so
# anything the platform or the shell sets (DOMAIN, PORT, NUM_WORKERS, ...)
# wins over this file. NODE_OPTIONS is left out on purpose: pass the heap cap
# on the command line (a command-line flag also wins over NODE_OPTIONS).
#
# Set DOMAIN yourself. Leave SUBDOMAIN, LOBBY_COORDINATOR, CDN_BASE and the
# OTEL_* variables unset.
NODE_ENV=production
GAME_ENV=prod
PORT=8080
WORKER_PROXY=inprocess
NUM_WORKERS=1
INSTANCE_LETTER=a
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The server refuses to start without GIT_COMMIT. The tarball's version is in
# static/commit.txt: export GIT_COMMIT="$(cat static/commit.txt)" to report it.
GIT_COMMIT=unknown
